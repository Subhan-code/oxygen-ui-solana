{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "crypto-progress-ring-green",
  "title": "Crypto Progress Ring Green",
  "description": "A glowing green circular SVG progress ring card displaying percentage metrics.",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "path": "components/ui/crypto-progress-ring-green.tsx",
      "content": "\"use client\"\n\nimport React from \"react\"\nimport { motion } from \"motion/react\"\nimport { cn } from \"@/lib/utils\"\n\nexport interface CryptoProgressRingGreenProps\n  extends React.HTMLAttributes<HTMLDivElement> {\n  percent?: number\n  label?: string\n}\n\nexport function CryptoProgressRingGreen({\n  percent = 84,\n  label = \"Staking Capacity\",\n  className,\n  ...props\n}: CryptoProgressRingGreenProps) {\n  return (\n    <div\n      data-slot=\"root\"\n      className={cn(\n        \"relative mx-auto flex w-full max-w-sm flex-col items-center justify-center overflow-hidden rounded-3xl bg-zinc-950 p-6 text-white shadow-xl border border-zinc-800 font-sans\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"relative flex h-40 w-40 items-center justify-center\">\n        <svg className=\"h-full w-full rotate-[-90deg]\" viewBox=\"0 0 100 100\">\n          <circle\n            cx=\"50\"\n            cy=\"50\"\n            r=\"40\"\n            fill=\"none\"\n            stroke=\"#27272a\"\n            strokeWidth=\"7\"\n          />\n          <motion.circle\n            cx=\"50\"\n            cy=\"50\"\n            r=\"40\"\n            fill=\"none\"\n            stroke=\"#10b981\"\n            strokeWidth=\"7\"\n            strokeLinecap=\"round\"\n            strokeDasharray=\"251.2\"\n            initial={{ strokeDashoffset: 251.2 }}\n            animate={{ strokeDashoffset: 251.2 - (251.2 * percent) / 100 }}\n            transition={{ duration: 1.2, ease: \"easeOut\" }}\n          />\n        </svg>\n\n        <div className=\"absolute flex flex-col items-center justify-center text-center\">\n          <span className=\"text-3xl font-extrabold text-white\">{percent}%</span>\n          <span className=\"text-xs font-semibold text-emerald-500 mt-0.5\">{label}</span>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}