{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "crypto-wallet-dashboard",
  "title": "Wallet Dashboard",
  "description": "A mobile crypto wallet dashboard with account navigation, balance breakdown, drawer navigation, and settings sheet.",
  "dependencies": [
    "motion",
    "lucide-react"
  ],
