{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "svg-path-drawing",
  "title": "SVG Path Drawing Suite",
  "description": "A showcase of line drawing techniques, polygon strokes, checkmark reveals, and chasing loaders.",
  "dependencies": [
    "motion",
    "lucide-react"
  ],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "path": "components/ui/svg-path-drawing.tsx",
      "content": "\"use client\";\n\nimport React, { useState } from \"react\";\nimport { motion } from \"motion/react\";\nimport { Sparkles, RotateCcw } from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\n\nexport function SvgPathDrawing({ className }: { className?: string }) {\n  const [animationKey, setAnimationKey] = useState(0);\n\n  const restart = () => {\n    setAnimationKey((prev) => prev + 1);\n  };\n\n  return (\n    <div\n      data-slot=\"svg-path-drawing\"\n      className={cn(\n        \"flex flex-col items-center justify-center gap-8 p-8 w-full max-w-lg mx-auto select-none rounded-3xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950 shadow-2xl\",\n        className\n      )}\n    >\n      <div className=\"flex items-center justify-between w-full px-2\">\n        <div className=\"flex items-center gap-2\">\n          <Sparkles className=\"h-4 w-4 text-pink-500\" />\n          <span className=\"text-xs font-bold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 font-mono\">\n            SVG Path Draw Suite\n          </span>\n        </div>\n        <button\n          type=\"button\"\n          onClick={restart}\n          className=\"flex items-center gap-1 text-xs font-semibold text-pink-500 hover:underline cursor-pointer\"\n        >\n          <RotateCcw className=\"h-3 w-3\" />\n          <span>Replay Draw</span>\n        </button>\n      </div>\n\n      {/* Interactive SVG Display Grid */}\n      <div className=\"grid grid-cols-2 gap-4 w-full\" key={animationKey}>\n        {/* 1. Geometric Diamond / Star Draw */}\n        <div className=\"flex flex-col items-center justify-center p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800 gap-3\">\n          <svg\n            viewBox=\"0 0 100 100\"\n            className=\"h-20 w-20 stroke-pink-500 fill-none\"\n          >\n            <motion.polygon\n              points=\"50,5 90,50 50,95 10,50\"\n              strokeWidth=\"4\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              initial={{ pathLength: 0 }}\n              animate={{ pathLength: 1 }}\n              transition={{\n                duration: 2,\n                ease: \"easeInOut\",\n              }}\n            />\n          </svg>\n          <span className=\"text-[11px] font-mono text-neutral-500\">\n            Polygon pathLength\n          </span>\n        </div>\n\n        {/* 2. Success Checkmark Draw */}\n        <div className=\"flex flex-col items-center justify-center p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800 gap-3\">\n          <svg\n            viewBox=\"0 0 100 100\"\n            className=\"h-20 w-20 stroke-emerald-500 fill-none\"\n          >\n            <motion.circle\n              cx=\"50\"\n              cy=\"50\"\n              r=\"40\"\n              strokeWidth=\"4\"\n              initial={{ pathLength: 0 }}\n              animate={{ pathLength: 1 }}\n              transition={{ duration: 1.2, ease: \"easeOut\" }}\n            />\n            <motion.path\n              d=\"M30 50 L45 65 L70 35\"\n              strokeWidth=\"5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              initial={{ pathLength: 0 }}\n              animate={{ pathLength: 1 }}\n              transition={{ duration: 0.8, delay: 0.8, ease: \"easeOut\" }}\n            />\n          </svg>\n          <span className=\"text-[11px] font-mono text-neutral-500\">\n            Sequential Checkmark\n          </span>\n        </div>\n\n        {/* 3. Infinite Chasing Loader */}\n        <div className=\"flex flex-col items-center justify-center p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800 gap-3\">\n          <svg\n            viewBox=\"0 0 100 100\"\n            className=\"h-20 w-20 stroke-purple-500 fill-none\"\n          >\n            <circle\n              cx=\"50\"\n              cy=\"50\"\n              r=\"38\"\n              strokeWidth=\"4\"\n              className=\"stroke-neutral-200 dark:stroke-neutral-800\"\n            />\n            <motion.circle\n              cx=\"50\"\n              cy=\"50\"\n              r=\"38\"\n              strokeWidth=\"4\"\n              strokeLinecap=\"round\"\n              strokeDasharray=\"60 180\"\n              animate={{ rotate: 360 }}\n              transition={{\n                duration: 1.5,\n                ease: \"linear\",\n                repeat: Infinity,\n              }}\n              style={{ transformOrigin: \"center center\" }}\n            />\n          </svg>\n          <span className=\"text-[11px] font-mono text-neutral-500\">\n            Chasing-line Loader\n          </span>\n        </div>\n\n        {/* 4. Spring Pulse Heart Wave */}\n        <div className=\"flex flex-col items-center justify-center p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-100 dark:border-neutral-800 gap-3\">\n          <svg\n            viewBox=\"0 0 100 100\"\n            className=\"h-20 w-20 stroke-indigo-500 fill-none\"\n          >\n            <motion.path\n              d=\"M10,50 Q25,20 40,50 T70,50 T90,50\"\n              strokeWidth=\"4\"\n              strokeLinecap=\"round\"\n              initial={{ pathLength: 0 }}\n              animate={{ pathLength: 1 }}\n              transition={{\n                type: \"spring\",\n                stiffness: 150,\n                damping: 15,\n                repeat: Infinity,\n                repeatDelay: 1,\n              }}\n            />\n          </svg>\n          <span className=\"text-[11px] font-mono text-neutral-500\">\n            Spring Sine Wave\n          </span>\n        </div>\n      </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}